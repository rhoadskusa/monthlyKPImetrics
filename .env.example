# Copy this file to a ".env" somewhere OUTSIDE this cloned repo folder
# (e.g. your Documents or OneDrive) and fill in real values.
# The first run of main.py opens a file picker asking you to select that
# .env file; it then remembers the path so you aren't asked again.
# Never commit a real .env, never paste its contents into a chat session,
# and never upload it into a cloud/remote Claude Code session -- this
# report is only ever meant to run with real credentials on your own
# local machine.

# --- SQL Server (corp-prod-sql.database.windows.net / corp-prod-mdb-db) ---
DB_SERVER=corp-prod-sql.database.windows.net
DB_NAME=corp-prod-mdb-db
DB_USER=your_sql_username
DB_PASSWORD=your_sql_password
# Set to "yes" instead of using DB_USER/DB_PASSWORD if you authenticate via
# Windows/AD integrated auth.
DB_TRUSTED_CONNECTION=no
# The exact ODBC driver name installed on this machine, no braces. Defaults
# to "ODBC Driver 18 for SQL Server" if left blank. If you get a "Data
# source name not found" error, run this to see what's actually installed
# and copy one of those names in exactly:
#   python -c "import pyodbc; print(pyodbc.drivers())"
# Common values: "ODBC Driver 18 for SQL Server", "ODBC Driver 17 for SQL
# Server", or the older driver that ships with Windows, "SQL Server".
DB_DRIVER=ODBC Driver 18 for SQL Server

# --- AirTable (Properties table, used for active-portfolio scoping) ---
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID=your_airtable_base_id
AIRTABLE_TABLE_PROPERTIES=your_properties_table_id_or_name

# --- Yardi Work Order Directory exports ---
# Local folder path where your OneDrive/SharePoint sync keeps the monthly
# Work Order Directory .xlsx exports. All files in this folder are read.
# Windows example: C:\Users\yourname\OneDrive - ParentCO\Work Orders
WORK_ORDER_DIR=C:\path\to\your\OneDrive\synced\WorkOrders\folder

# --- Output ---
# Where the monthly report (.xlsx and .csv) gets written. Defaults to an
# "output" folder next to this script if left blank.
REPORT_OUTPUT_DIR=

# --- Report period ---
# Target month for the report, formatted YYYY-MM. Leave blank to default to
# the previous calendar month.
REPORT_PERIOD=
